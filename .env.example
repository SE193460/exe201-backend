# Copy this file to `.env` and fill in real values.
# Generate a strong JWT secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

NODE_ENV=development
PORT=3000

# Require users to confirm their email before logging in.
# Defaults to true when NODE_ENV=production, false otherwise.
# Set to "false" to skip verification during local testing.
REQUIRE_EMAIL_VERIFICATION=false

# PostgreSQL connection string (e.g. Supabase, local docker-compose)
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Must be a strong random value. Placeholders like "replace_me" are rejected.
JWT_SECRET=

# Public URL of this API (required in production)
BACKEND_URL=http://localhost:3000
# URL of the frontend, used for CORS and OAuth redirects
FRONTEND_URL=http://localhost:5173
# Optional comma-separated additional origins, for example Vercel preview URLs.
# CORS_ORIGINS=https://preview.example.com,https://another-preview.example.com

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email delivery ---
# Prefer SMTP (works with Gmail app passwords, Brevo, Mailtrap, etc.).
# If SMTP_HOST is set, SMTP is used; otherwise RESEND_API_KEY is used as fallback.
SMTP_HOST=
SMTP_PORT=587
# Use "true" for port 465 (implicit TLS), "false" for 587/25 (STARTTLS).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=RoomMate <no-reply@yourdomain.com>

# Optional fallback channel
RESEND_API_KEY=

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: bootstrap an admin account on startup
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Comma-separated host suffixes the image proxy may fetch from.
# Defaults to fbcdn.net,facebook.com,cloudinary.com
# IMAGE_PROXY_ALLOWED_HOSTS=fbcdn.net,cloudinary.com

# --- AI Assistant ---
# Optional. When a key is set, the assistant answers with an OpenAI-compatible
# chat model; otherwise it falls back to built-in offline FAQ answers.
# Default provider is OpenRouter with a FREE model, so one key is enough.
#   Get a key at https://openrouter.ai/keys
#   Free models list: https://openrouter.ai/models?max_price=0
# Anyone testing their own copy must add their OWN key here.
# ASSISTANT_API_KEY=
# ASSISTANT_API_BASE_URL=https://openrouter.ai/api/v1
# ASSISTANT_MODEL=deepseek/deepseek-chat-v3-0324:free
# Other OpenAI-compatible options:
#   OpenAI: ASSISTANT_API_BASE_URL=https://api.openai.com/v1  ASSISTANT_MODEL=gpt-4o-mini
#   Groq:   ASSISTANT_API_BASE_URL=https://api.groq.com/openai/v1  ASSISTANT_MODEL=llama-3.3-70b-versatile
